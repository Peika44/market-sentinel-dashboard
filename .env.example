# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set DEMO_MODE=true to run the full dashboard without any API credentials.
# Both scanners and the intraday confirmation engine return pre-canned results
# with an animated progress bar so the UI is fully exercisable offline.
DEMO_MODE=false

# ── Market data ───────────────────────────────────────────────────────────────
# Set to `synthetic` if you want live watchlist prices without Alpaca credentials.
# Set to `alpaca` for real-time price streaming.
MARKET_DATA_PROVIDER=alpaca
APCA_API_KEY_ID=your_alpaca_key
APCA_API_SECRET_KEY=your_alpaca_secret
ALPACA_FEED=iex
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADING_URL=https://paper-api.alpaca.markets

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
TARGET_SYNC_INTERVAL_SECONDS=5.0

# ── Notifications (optional) ──────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
